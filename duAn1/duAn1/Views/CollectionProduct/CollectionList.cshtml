@model List<Product>
@foreach (var item in Model)
{
<div class="glass-card rounded-xl overflow-hidden group flex flex-col h-full animate-fade-in cursor-pointer border border-white/50" data-product-id="@item.Id">
    <div class="relative h-48 md:h-56 overflow-hidden bg-white">
        <a asp-controller="Product" asp-action="ProductDetail" asp-route-id="@item.Id" class="block absolute inset-0 z-10"></a>
        <img src="@item.Image" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 relative z-0" alt="@item.Name" />
        <button onclick="toggleFavorite(@item.Id, this)" class="favorite-btn absolute top-2 right-2 p-1.5 rounded-full bg-white/80 hover:bg-white text-pink-500 transition-colors shadow-sm z-20 backdrop-blur-sm" title="Thêm vào yêu thích">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
        </button>
    </div>
    <div class="p-3 flex flex-col flex-grow">
        <div class="text-[10px] text-blue-500 uppercase tracking-wider mb-1">@(item.Category?.Name ?? "Không xác định")</div>
        <a asp-controller="Product" asp-action="ProductDetail" asp-route-id="@item.Id" class="block">
            <h3 class="text-sm font-bold text-slate-800 mb-1 group-hover:text-blue-600 transition-colors line-clamp-2 min-h-[2.5em]">@item.Name</h3>
        </a>
        <div class="mt-auto pt-2 flex items-center justify-between">
            <span class="text-base font-bold text-blue-600">@duAn1.Utils.PriceFormatter.FormatVND(item.Price)</span>
            <button onclick="addCart(@item.Id)" class="bg-slate-800 hover:bg-blue-600 text-white w-8 h-8 rounded-lg transition-all shadow-md flex items-center justify-center active:scale-95 z-20" title="Thêm vào giỏ">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0v3m0-3h3m-3 0H9" />
                </svg>
            </button>
        </div>
    </div>
</div>
}

<style>
    .favorite-btn {
        transition: all 0.3s ease;
    }

    .favorite-btn.favorite-active {
        background-color: rgba(236, 72, 153, 0.3) !important;
        color: rgb(236, 72, 153) !important;
    }
</style>