@model Product
<div class="max-w-3xl mx-auto p-6 bg-white rounded-xl shadow-md mt-8 animate-fade-in">
    <div class="flex flex-col md:flex-row gap-8">
        <div class="flex-shrink-0 w-full md:w-1/2">
            <img src="@Model.Image" alt="@Model.Name" class="w-full h-80 object-cover rounded-lg border" />
        </div>
        <div class="flex-1 flex flex-col gap-4">
            <h1 class="text-2xl font-bold text-blue-900 font-serif">@Model.Name</h1>
            <div class="text-blue-600 font-semibold text-lg">@(Model.Price?.ToString("N0") ?? "0") ₫</div>
            <div class="text-slate-700">@Model.Description</div>
            <div class="text-sm text-slate-500">Danh mục: <span class="font-semibold">@Model.Category?.Name</span></div>
            <div class="flex items-center gap-4 mt-6">
                <span class="font-bold text-slate-700 text-lg">Số lượng:</span>
                <div class="flex items-center bg-white border border-slate-300 rounded-xl overflow-hidden shadow-sm">
                    <button type="button" id="btnMinus" class="px-5 py-3 hover:bg-slate-50 transition-colors text-slate-600 font-bold text-lg">-</button>
                    <input type="number" id="quantityInput" value="1" min="1" readonly class="w-16 text-center border-x border-slate-300 py-3 outline-none text-slate-800 font-bold bg-transparent" />
                    <button type="button" id="btnPlus" class="px-5 py-3 hover:bg-slate-50 transition-colors text-slate-600 font-bold text-lg">+</button>
                </div>
            </div>
            <button id="addToCartBtn" class="mt-6 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-xl transition-colors shadow-md w-max flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
                </svg>
                Thêm vào giỏ hàng
            </button>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var minusBtn = document.getElementById('btnMinus');
        var plusBtn = document.getElementById('btnPlus');
        var qtyInput = document.getElementById('quantityInput');
        var addBtn = document.getElementById('addToCartBtn');
        if (minusBtn && plusBtn && qtyInput) {
            minusBtn.onclick = function() {
                var val = parseInt(qtyInput.value);
                if (val > 1) qtyInput.value = val - 1;
            };
            plusBtn.onclick = function() {
                var val = parseInt(qtyInput.value);
                qtyInput.value = val + 1;
            };
        }
        if (addBtn && qtyInput) {
            addBtn.onclick = function() {
                var qty = parseInt(qtyInput.value);
                if (typeof addCart === 'function') {
                    addCart(@Model.Id, qty);
                } else {
                    alert('Không tìm thấy hàm thêm vào giỏ hàng!');
                }
            };
        }
    });
</script>
