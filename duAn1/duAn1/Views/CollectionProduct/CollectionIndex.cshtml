@model (List<Product> Products, List<Category> Categories, int? CategoryId)


<div class="container mx-auto px-4 py-8">
	<h1 class="text-3xl font-bold text-slate-800 mb-8 font-serif text-center">Bộ Sưu Tập Trang Sức</h1>

	<!-- Filter Bar -->
	<div class="glass-panel p-4 rounded-xl mb-8 flex flex-wrap gap-4 items-center justify-center">
		<a href="javascript:void(0)"
		data-id=""
		class="category-btn px-5 py-2 rounded-full transition-all
		@(Model.CategoryId == null ? "bg-blue-600 text-white" : "bg-white text-slate-600 hover:bg-blue-100")"
		onclick="filterCategory(null,this)">
			Tất Cả
		</a>

		@foreach (var item in Model.Categories)
		{
			<a href="javascript:void(0)"
			data-id="@item.Id"
			class="category-btn px-5 py-2 rounded-full transition-all
			@(Model.CategoryId == item.Id ? "bg-blue-600 text-white" : "bg-white text-slate-600 hover:bg-blue-100")"
			onclick="filterCategory(@item.Id,this)">
				@item.Name
			</a>
		}
	</div>

	<!-- Grid -->
	<div id="product-container" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
		@await Html.PartialAsync("~/Views/CollectionProduct/CollectionList.cshtml", Model.Products)		</div>
	</div>

<script src="~/js/collection.js"></script>