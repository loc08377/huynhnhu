@{
    var role = Context.User.FindFirst("Role")?.Value;
    var path = Context.Request.Path.Value?.ToLower() ?? "";
    // Nếu là admin và vào trang /adminjewel thì dùng layout admin, còn lại dùng layout thường
    Layout = (role == "1" && path.StartsWith("/adminjewel")) ? "_LayoutAdmin" : "_Layout";
}