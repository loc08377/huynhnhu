@model List<Cart>

<div class="w-full px-4 md:px-8 py-8 min-h-screen">
    <h1 class="text-3xl font-bold text-slate-800 mb-8 font-serif text-center">Giỏ Hàng Của Bạn</h1>

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div class="flex items-center gap-3">
            <input type="checkbox" id="cart-check-all" class="form-checkbox w-5 h-5 accent-blue-600">
            <label for="cart-check-all" class="font-semibold text-slate-700 select-none cursor-pointer">Chọn tất cả</label>
        </div>
        <div class="flex items-center gap-2">
            <input id="cart-search-input" type="text" placeholder="Tìm theo ngày hoặc tên sản phẩm..." class="border border-slate-300 rounded-lg px-3 py-2 w-64 focus:outline-none focus:ring-2 focus:ring-blue-300" />
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-4 gap-8">
        <!-- Cart Items List -->
        <div class="xl:col-span-3 space-y-4 max-h-[520px] overflow-y-auto pr-2">
            @foreach (var group in Model
                .Where(c => c.CreateDate.HasValue)
                .GroupBy(c => c.CreateDate!.Value.Date)
                .OrderByDescending(g => g.Key))
            {
                var dayKey = group.Key.ToString("yyyy-MM-dd");
                <div class="mb-6 cart-group">
                    <div class="flex items-center gap-2 mb-2 pl-1">
                        <input type="checkbox" class="cart-day-checkbox form-checkbox w-5 h-5 accent-blue-600" data-day="@dayKey" id="day-@dayKey" />
                        <label for="day-@dayKey" class="font-bold text-blue-700 text-base select-none cursor-pointer">Ngày @group.Key.ToString("dd/MM/yyyy")</label>
                    </div>
                    <div class="space-y-3">
                        @foreach (var cart in group)
                        {
                            <div class="glass-card border border-slate-200 shadow-lg p-3 rounded-xl flex items-center gap-4 min-h-[90px] bg-white/70 cart-item-row" data-name="@cart.Product.Name" data-date="@group.Key.ToString("dd/MM/yyyy")" data-cart-id="@cart.Id" data-price="@cart.Product.Price" data-quantity="@cart.Quantity">
                                <input type="checkbox" class="cart-item-checkbox form-checkbox w-5 h-5 accent-blue-600 mr-2" data-day="@dayKey" />
                                <div class="w-20 h-20 flex-shrink-0 bg-white rounded-lg overflow-hidden border border-slate-200 shadow-sm">
                                    <img src="@cart.Product.Image"
                                        width="80"
                                        height="80"
                                        class="w-full h-full object-cover"
                                        alt="@cart.Product.Name" />
                                </div>
                                <div class="flex-grow flex flex-col justify-center">
                                    <div class="flex items-center justify-between gap-2">
                                        <h3 class="font-bold text-slate-800 font-serif text-base mb-0 line-clamp-1">@cart.Product.Name</h3>
                                        <div class="text-blue-600 font-bold text-base whitespace-nowrap">@String.Format("{0:N0}", cart.Product.Price)₫</div>
                                    </div>
                                </div>
                                <div class="flex flex-col items-center sm:items-end gap-2 min-w-[110px]">
                                    <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg shadow-inner">
                                        <button onclick="handleMinusQuantity(this)" class="px-3 py-1 text-slate-600 hover:text-blue-600 font-bold hover:bg-white rounded-l-lg transition-colors">-</button>
                                        <span class="w-8 text-center text-base font-bold text-slate-800">@cart.Quantity</span>
                                        <button onclick="handlePlusQuantity(this)" class="px-3 py-1 text-slate-600 hover:text-blue-600 font-bold hover:bg-white rounded-r-lg transition-colors">+</button>
                                    </div>
                                    <button onclick="handleRemoveCartItem(this)" class="text-xs text-red-400 hover:text-red-600 hover:underline flex items-center gap-1 transition-colors">Xóa</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            @* Nếu có cart không có CreateDate *@
            @if (Model.Any(c => !c.CreateDate.HasValue))
            {
                <div class="mb-6 cart-group">
                    <div class="flex items-center gap-2 mb-2 pl-1">
                        <input type="checkbox" class="cart-day-checkbox form-checkbox w-5 h-5 accent-blue-600" data-day="unknown" id="day-unknown" />
                        <label for="day-unknown" class="font-bold text-blue-700 text-base select-none cursor-pointer">Không xác định ngày</label>
                    </div>
                    <div class="space-y-3">
                        @foreach (var cart in Model.Where(c => !c.CreateDate.HasValue))
                        {
                            <div class="glass-card border border-slate-200 shadow-lg p-3 rounded-xl flex items-center gap-4 min-h-[90px] bg-white/70 cart-item-row" data-name="@cart.Product.Name" data-date="" data-cart-id="@cart.Id" data-price="@cart.Product.Price" data-quantity="@cart.Quantity">
                                <input type="checkbox" class="cart-item-checkbox form-checkbox w-5 h-5 accent-blue-600 mr-2" data-day="unknown" />
                                <div class="w-20 h-20 flex-shrink-0 bg-white rounded-lg overflow-hidden border border-slate-200 shadow-sm">
                                    <img src="@cart.Product.Image"
                                        width="80"
                                        height="80"
                                        class="w-full h-full object-cover"
                                        alt="@cart.Product.Name" />
                                </div>
                                <div class="flex-grow flex flex-col justify-center">
                                    <div class="flex items-center justify-between gap-2">
                                        <h3 class="font-bold text-slate-800 font-serif text-base mb-0 line-clamp-1">@cart.Product.Name</h3>
                                        <div class="text-blue-600 font-bold text-base whitespace-nowrap">@String.Format("{0:N0}", cart.Product.Price)₫</div>
                                    </div>
                                </div>
                                <div class="flex flex-col items-center sm:items-end gap-2 min-w-[110px]">
                                    <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg shadow-inner">
                                        <button class="px-3 py-1 text-slate-600 hover:text-blue-600 font-bold hover:bg-white rounded-l-lg transition-colors">-</button>
                                        <span class="w-8 text-center text-base font-bold text-slate-800">@cart.Quantity</span>
                                        <button class="px-3 py-1 text-slate-600 hover:text-blue-600 font-bold hover:bg-white rounded-r-lg transition-colors">+</button>
                                    </div>
                                    <button class="text-xs text-red-400 hover:text-red-600 hover:underline flex items-center gap-1 transition-colors">Xóa</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            <script src="~/js/cart.js"></script>
        </div>

        <!-- Summary -->
        <div class="xl:col-span-1">
            <div class="glass-panel border border-slate-200 shadow-xl p-6 rounded-2xl sticky top-24 bg-white/80">
                <h3 class="text-xl font-bold text-slate-800 mb-5 font-serif border-b border-slate-200 pb-3">Tổng Đơn Hàng</h3>
                
                <!-- Danh sách sản phẩm đã chọn -->
                <div class="mb-6 pb-4 border-b border-slate-200">
                    <div id="cart-selected-items" class="space-y-2 max-h-64 overflow-y-auto">
                        <p class="text-sm text-slate-500 italic">Chọn sản phẩm để xem chi tiết</p>
                    </div>
                </div>

                <div class="space-y-3 mb-6">
                    <div class="flex justify-between text-slate-600">
                        <span>Số lượng</span>
                        <span id="cart-total-qty" class="font-semibold text-slate-800">0</span>
                    </div>
                    <div class="flex justify-between text-slate-600">
                        <span>Tạm tính</span>
                        <span id="cart-subtotal">0₫</span>
                    </div>
                    <div class="flex justify-between text-slate-600">
                        <span>Vận chuyển</span>
                        <span class="text-green-600 font-medium bg-green-50 px-2 py-0.5 rounded-full text-sm">Miễn phí</span>
                    </div>
                    <div class="border-t border-slate-300 pt-3 mt-1 flex justify-between items-center">
                        <span class="font-bold text-slate-800 text-base">Tổng cộng</span>
                        <span class="text-xl font-bold text-blue-600" id="cart-total">0₫</span>
                    </div>
                </div>
                <button onclick="showCheckoutModal()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-xl shadow-lg hover:shadow-blue-500/40 transition-all active:scale-[0.98] flex justify-center items-center gap-2 text-base">
                    Thanh Toán
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                </button>
                <div class="mt-5 text-center">
                    <a href="/" class="text-sm text-slate-500 hover:text-blue-600 font-medium transition-colors">Tiếp tục mua sắm</a>
                </div>
            </div>
        </div>

        <!-- Checkout Modal Popup -->
        <div id="checkoutModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full animate-fade-in">
                <!-- Modal Header -->
                <div class="bg-gradient-to-r from-blue-600 to-blue-700 p-6 flex items-center justify-between rounded-t-2xl">
                    <h2 class="text-xl font-bold text-white font-serif">Xác Nhận Đơn Hàng</h2>
                    <button onclick="closeCheckoutModal()" class="text-white hover:bg-blue-800 w-8 h-8 flex items-center justify-center rounded-full transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="p-6">
                    <!-- Order Summary -->
                    <div class="mb-6 pb-4 border-b border-slate-200">
                        <p class="text-sm font-semibold text-slate-600 mb-3">Chi tiết đơn hàng</p>
                        <div class="space-y-2">
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-600">Số lượng:</span>
                                <span class="font-semibold text-slate-800" id="modal-qty">0</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-600">Tạm tính:</span>
                                <span class="font-semibold text-slate-800" id="modal-total">0₫</span>
                            </div>
                            <div class="flex justify-between text-sm pt-2 border-t border-slate-200">
                                <span class="font-bold text-slate-800">Tổng:</span>
                                <span class="font-bold text-blue-600 text-lg" id="modal-grand-total">0₫</span>
                            </div>
                        </div>
                    </div>

                    <!-- Address Input -->
                    <div>
                        <label for="deliveryAddress" class="block text-sm font-semibold text-slate-700 mb-2">
                            Địa chỉ giao hàng <span class="text-red-600">*</span>
                        </label>
                        <textarea id="deliveryAddress" 
                                  placeholder="Nhập địa chỉ giao hàng (VD: 123 Đường ABC, Phường XYZ, Quận 1, TP.HCM)"
                                  class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"
                                  rows="3"
                                  required></textarea>
                        <p class="text-xs text-slate-500 mt-1">Vui lòng nhập địa chỉ giao hàng chính xác</p>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="bg-slate-50 p-6 flex gap-3 rounded-b-2xl border-t border-slate-200">
                    <button onclick="closeCheckoutModal()" class="flex-1 border border-slate-300 text-slate-700 font-semibold py-2.5 px-4 rounded-lg hover:bg-slate-100 transition-colors">
                        Hủy
                    </button>
                    <button onclick="submitCheckout()" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-colors flex items-center justify-center gap-2">
                        <span>Xác Nhận</span>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <script src="~/js/Order.js"></script>
        </script>

