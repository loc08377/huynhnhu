<script>

function confirmDelete(userId,userName){

let confirmDeleteUser = confirm(
"Xóa Người Dùng?\n\n"+
"Bạn có chắc chắn muốn xóa người dùng '"+userName+"' ?\n"+
"Dữ liệu lịch sử đơn hàng của họ cũng sẽ bị ẩn."
);

if(confirmDeleteUser){

let row = document.getElementById("user-"+userId);

if(row){
row.remove();
}

alert("Đã xóa người dùng thành công");

}

}

</script>