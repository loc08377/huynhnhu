<div class="space-y-8 animate-fade-in">
  <h1 class="text-3xl font-bold text-slate-800 font-serif">Tổng Quan</h1>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

    <!-- Revenue -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-4">
      <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
          stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <div class="text-sm text-slate-500">Doanh thu tháng</div>
        <div class="text-2xl font-bold text-slate-800">@ViewBag.MonthlyRevenue.ToString("N0") ₫</div>
      </div>
    </div>

    <!-- Orders -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-4">
      <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
          stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
        </svg>
      </div>
      <div>
        <div class="text-sm text-slate-500">Đơn hàng chờ xác nhận</div>
        <div class="text-2xl font-bold text-slate-800">@ViewBag.NewOrders</div>
      </div>
    </div>

    <!-- Products -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-4">
      <div class="w-12 h-12 bg-green-100 text-green-600 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
          stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
        </svg>
      </div>
      <div>
        <div class="text-sm text-slate-500">Sản phẩm</div>
        <div class="text-2xl font-bold text-slate-800">@ViewBag.TotalProducts</div>
      </div>
    </div>

    <!-- Customers -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-4">
      <div class="w-12 h-12 bg-orange-100 text-orange-600 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
          stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0z" />
        </svg>
      </div>
      <div>
        <div class="text-sm text-slate-500">Khách hàng</div>
        <div class="text-2xl font-bold text-slate-800">@ViewBag.TotalCustomers</div>
      </div>
    </div>

  </div>

  <!-- Recent Orders -->
  <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
    <h2 class="text-xl font-bold text-slate-800 mb-6">Đơn Hàng Gần Đây</h2>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">

        <thead>
          <tr class="text-slate-500 border-b border-slate-100 text-sm">
            <th class="py-3 font-medium">Mã Đơn</th>
            <th class="py-3 font-medium">Khách Hàng</th>
            <th class="py-3 font-medium">Ngày</th>
            <th class="py-3 font-medium">Tổng Tiền</th>
            <th class="py-3 font-medium">Trạng Thái</th>
            <th class="py-3 font-medium">Hành Động</th>
          </tr>
        </thead>

        <tbody class="text-slate-700 text-sm">
          @if (ViewBag.RecentOrders != null && ViewBag.RecentOrders.Count > 0)
          {
            @foreach (var order in ViewBag.RecentOrders)
            {
              var statusText = "Unknown";
              var statusColor = "bg-gray-100 text-gray-700";
              var totalAmount = 0;
              if (order.OrderDetails != null)
              {
                foreach (var od in order.OrderDetails)
                {
                  totalAmount += (int)(od.Price * od.Quantity);
                }
              }

              if (order.payment_status == 0)
              {
                statusText = "Chờ xác nhận";
                statusColor = "bg-yellow-100 text-yellow-700";
              }
              else if (order.payment_status == 1)
              {
                statusText = "Đang giao";
                statusColor = "bg-blue-100 text-blue-700";
              }
              else if (order.payment_status == 2)
              {
                statusText = "Đã nhận";
                statusColor = "bg-green-100 text-green-700";
              }
              else if (order.payment_status == 3)
              {
                statusText = "Đã hủy";
                statusColor = "bg-red-100 text-red-700";
              }
              else if (order.payment_status == 4)
              {
                statusText = "Từ chối";
                statusColor = "bg-gray-100 text-gray-700";
              }

              <tr class="border-b border-slate-50 hover:bg-slate-50" data-order-id="@order.Id" data-order-status="@order.payment_status">
                <td class="py-3 text-blue-600 font-medium">ORD@(order.Id.ToString("D4"))</td>
                <td class="py-3">@(order.User?.FullName ?? "N/A")</td>
                <td class="py-3">@order.CreateDate.ToString("dd/MM/yyyy")</td>
                <td class="py-3">@totalAmount.ToString("N0") ₫</td>
                <td class="py-3">
                  <span class="px-2 py-1 rounded-full text-xs font-bold @statusColor">
                    @statusText
                  </span>
                </td>
                <td class="py-3">
                  @if (order.payment_status == 0)
                  {
                    <!-- Trạng thái 0: Chờ xác nhận -->
                    <div class="flex gap-2">
                      <button onclick="confirmOrder(@order.Id)" class="px-2 py-1 bg-green-500 hover:bg-green-600 text-white text-xs rounded transition">
                        Xác Nhận
                      </button>
                      <button onclick="rejectOrder(@order.Id)" class="px-2 py-1 bg-red-500 hover:bg-red-600 text-white text-xs rounded transition">
                        Từ Chối
                      </button>
                    </div>
                  }
                  else if (order.payment_status == 1)
                  {
                    <!-- Trạng thái 1: Đang giao - client sẽ xác nhận nhận hàng -->
                    <span class="text-xs text-slate-500">Chờ client xác nhận</span>
                  }
                  else if (order.payment_status == 2)
                  {
                    <!-- Trạng thái 2: Đã nhận -->
                    <span class="text-xs text-slate-500">Hoàn thành</span>
                  }
                  else if (order.payment_status == 3 || order.payment_status == 4)
                  {
                    <!-- Trạng thái 3, 4: Đã hủy/Từ chối -->
                    <span class="text-xs text-slate-500">-</span>
                  }
                </td>
              </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="6" class="py-4 text-center text-slate-500">Không có đơn hàng nào</td>
            </tr>
          }

        </tbody>
      </table>
    </div>
  </div>

</div>

<script>
  // Active tab Dashboard ở sidebar
  document.addEventListener('DOMContentLoaded', () => {
    const dashboardLink = document.querySelector('a[href*="Dashboard"], a[href*="Home/Index"]');
    if (dashboardLink) {
      dashboardLink.closest('li')?.classList.add('active');
      dashboardLink.classList.add('bg-blue-600', 'text-white');
    }
  });

  // Hàm xác nhận đơn hàng
  window.confirmOrder = function(orderId) {
    // Lấy status hiện tại từ tr
    const row = document.querySelector(`tr[data-order-id="${orderId}"]`);
    if (!row) {
      toastr.error('Không tìm thấy đơn hàng');
      return;
    }

    const currentStatus = parseInt(row.dataset.orderStatus);
    
    // Chỉ cho phép xác nhận nếu status = 0
    if (currentStatus !== 0) {
      const statusNames = {
        1: 'Đơn hàng đã được xác nhận',
        2: 'Đơn hàng đã hoàn thành',
        3: 'Đơn hàng đã bị hủy bởi client',
        4: 'Đơn hàng đã bị từ chối'
      };
      toastr.error(statusNames[currentStatus] || 'Không thể xác nhận đơn hàng này');
      setTimeout(() => location.reload(), 1500);
      return;
    }

    if (confirm('Xác nhận đơn hàng #ORD' + String(orderId).padStart(4, '0') + '?')) {
      customFetch(`/AdminJewel/UpdateOrderStatus/${orderId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ Status: 1 })
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            toastr.success('Xác nhận đơn hàng thành công');
            setTimeout(() => location.reload(), 1500);
          } else {
            toastr.error(data.message || 'Lỗi');
          }
        })
        .catch(err => {
          console.error(err);
          toastr.error('Có lỗi xảy ra');
        });
    }
  };

  // Hàm từ chối đơn hàng
  window.rejectOrder = function(orderId) {
    // Lấy status hiện tại từ tr
    const row = document.querySelector(`tr[data-order-id="${orderId}"]`);
    if (!row) {
      toastr.error('Không tìm thấy đơn hàng');
      return;
    }

    const currentStatus = parseInt(row.dataset.orderStatus);
    
    // Chỉ cho phép từ chối nếu status = 0
    if (currentStatus !== 0) {
      const statusNames = {
        1: 'Đơn hàng đã được xác nhận',
        2: 'Đơn hàng đã hoàn thành',
        3: 'Đơn hàng đã bị hủy bởi client',
        4: 'Đơn hàng đã bị từ chối'
      };
      toastr.error(statusNames[currentStatus] || 'Không thể từ chối đơn hàng này');
      setTimeout(() => location.reload(), 1500);
      return;
    }

    if (confirm('Từ chối đơn hàng #ORD' + String(orderId).padStart(4, '0') + '?')) {
      customFetch(`/AdminJewel/UpdateOrderStatus/${orderId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ Status: 4 })
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            toastr.success('Từ chối đơn hàng thành công');
            setTimeout(() => location.reload(), 1500);
          } else {
            toastr.error(data.message || 'Lỗi');
          }
        })
        .catch(err => {
          console.error(err);
          toastr.error('Có lỗi xảy ra');
        });
    }
  };
</script>