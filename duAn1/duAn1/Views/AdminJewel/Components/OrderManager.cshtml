@model List<Order>

<div class="space-y-6 animate-fade-in">
    <!-- Filter Section -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Trạng thái</label>
                <select id="statusFilter" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">- Tất cả trạng thái -</option>
                    <option value="0">Chờ xác nhận</option>
                    <option value="1">Đang giao</option>
                    <option value="2">Đã nhận được</option>
                    <option value="3">Đã hủy</option>
                    <option value="4">Từ chối</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Tìm kiếm ID đơn hàng</label>
                <input type="text" id="searchOrder" placeholder="VD: 123" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Khách hàng</label>
                <input type="text" id="customerFilter" placeholder="Tên khách hàng" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="flex items-end">
                <button id="resetFilter" class="w-full px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold rounded-lg transition-colors">
                    🔄 Đặt lại
                </button>
            </div>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-600 font-medium">Chờ xác nhận</p>
                    <p class="text-3xl font-bold text-amber-600">@(Model?.Count(o => o.PaymentStatus == 0) ?? 0)</p>
                </div>
                <div class="text-4xl">⏳</div>
            </div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-600 font-medium">Đang giao</p>
                    <p class="text-3xl font-bold text-blue-600">@(Model?.Count(o => o.PaymentStatus == 1) ?? 0)</p>
                </div>
                <div class="text-4xl">🚚</div>
            </div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-600 font-medium">Đã nhận được</p>
                    <p class="text-3xl font-bold text-green-600">@(Model?.Count(o => o.PaymentStatus == 2) ?? 0)</p>
                </div>
                <div class="text-4xl">✅</div>
            </div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-600 font-medium">Từ chối/Hủy</p>
                    <p class="text-3xl font-bold text-red-600">@(Model?.Count(o => o.PaymentStatus == 3 || o.PaymentStatus == 4) ?? 0)</p>
                </div>
                <div class="text-4xl">❌</div>
            </div>
        </div>
    </div>

    <!-- Orders List -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 border-b border-slate-200">
            <h2 class="text-xl font-bold text-slate-800">Danh sách đơn hàng</h2>
        </div>

        <div class="space-y-4 p-6">
            @if (Model != null && Model.Count() > 0)
            {
                @foreach (var order in Model)
                {
                    var orderDetailsList = ViewBag.OrderDetailsMap != null && ViewBag.OrderDetailsMap.ContainsKey(order.Id) ?
                        ViewBag.OrderDetailsMap[order.Id] as List<dynamic> :
                        new List<dynamic>();
                    var totalAmount = orderDetailsList != null ? 
                        orderDetailsList.Sum(od => (int)od.Price * (int)od.Quantity) : 0;

                    var statusText = order.PaymentStatus switch
                    {
                        0 => "Chờ xác nhận",
                        1 => "Đang giao",
                        2 => "Đã nhận được",
                        3 => "Đã hủy",
                        4 => "Từ chối",
                        _ => "Không rõ"
                    };

                    <div class="order-item border border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 bg-white" data-status="@order.PaymentStatus" data-order-id="@order.Id" data-order-status="@order.PaymentStatus">
                        <!-- Order Content -->
                        <div class="p-4 flex items-center justify-between gap-4">
                            <!-- Left: Order Info -->
                            <div class="flex items-center gap-4 flex-grow">
                                <div class="text-2xl font-bold text-blue-600 min-w-fit">
                                    #@order.Id
                                </div>
                                <div class="flex-grow">
                                    <h3 class="font-bold text-slate-800 text-sm">@(order.User?.FullName ?? "N/A")</h3>
                                    <p class="text-xs text-slate-500">📅 @order.CreateDate.ToString("dd/MM/yyyy HH:mm") | 📍 @(order.Address?.Length > 40 ? order.Address.Substring(0, 40) + "..." : order.Address ?? "N/A")</p>
                                </div>
                            </div>

                            <!-- Middle: Products Summary -->
                            <div class="flex gap-2 flex-wrap max-h-20 max-w-64 overflow-hidden text-xs">
                                @if (orderDetailsList != null && orderDetailsList.Count > 0)
                                {
                                    @foreach (var detail in orderDetailsList.Take(3))
                                    {
                                        var productName = detail.ProductName?.ToString() ?? "N/A";
                                        var displayName = productName.Length > 15 ? productName.Substring(0, 15) + "..." : productName;
                                        var quantity = detail.Quantity ?? 0;
                                        <span class="bg-slate-100 text-slate-700 px-2 py-1 rounded text-[11px] font-medium">@displayName x @quantity</span>
                                    }
                                    @if (orderDetailsList.Count > 3)
                                    {
                                        <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded text-[11px] font-bold">+@(orderDetailsList.Count - 3) sản phẩm khác</span>
                                    }
                                }
                            </div>

                            <!-- Right: Price, Status & Actions -->
                            <div class="flex items-center gap-3 min-w-fit">
                                <div class="text-right">
                                    @{
                                        var badgeClass = order.PaymentStatus switch
                                        {
                                            0 => "bg-amber-100 text-amber-700 border border-amber-300",
                                            1 => "bg-blue-100 text-blue-700 border border-blue-300",
                                            2 => "bg-green-100 text-green-700 border border-green-300",
                                            3 => "bg-red-100 text-red-700 border border-red-300",
                                            4 => "bg-gray-100 text-gray-700 border border-gray-300",
                                            _ => "bg-slate-100 text-slate-700"
                                        };
                                    }
                                    @* <div class="inline-block px-3 py-1.5 rounded-full text-xs font-bold @badgeClass mb-1">
                                        @statusText
                                    </div> *@
                                    <p class="text-lg font-bold text-blue-600">@totalAmount.ToString("N0") ₫</p>
                                </div>

                                <!-- Action Buttons -->
                                <div class="flex gap-2">
                                    @if (order.PaymentStatus == 0)
                                    {
                                        <button type="button" class="confirmOrderBtn bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-3 rounded-lg transition-all duration-300 transform hover:scale-110 shadow-md text-xs" data-order-id="@order.Id" title="Xác nhận đơn hàng">
                                            ✓ Duyệt
                                        </button>
                                        <button type="button" class="rejectOrderBtn bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-3 rounded-lg transition-all duration-300 transform hover:scale-110 shadow-md text-xs" data-order-id="@order.Id" title="Từ chối đơn hàng">
                                            ✖ Hủy
                                        </button>
                                    }
                                    else if (order.PaymentStatus == 1)
                                    {
                                        <div class="bg-blue-100 border border-blue-300 text-blue-700 font-bold py-2 px-3 rounded-lg text-xs whitespace-nowrap">
                                            ⏳ Đang giao
                                        </div>
                                    }
                                    else if (order.PaymentStatus == 2)
                                    {
                                        <div class="bg-green-100 border border-green-300 text-green-700 font-bold py-2 px-3 rounded-lg text-xs whitespace-nowrap">
                                            ✅ Hoàn tất
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bg-red-100 border border-red-300 text-red-700 font-bold py-2 px-3 rounded-lg text-xs whitespace-nowrap">
                                            ❌ Đã Hủy
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-16 bg-slate-50 rounded-xl border border-dashed border-slate-300">
                    <div class="text-4xl mb-3">📭</div>
                    <p class="text-slate-500 text-lg font-medium">Không có đơn hàng nào</p>
                </div>
            }
        </div>
    </div>
</div>


<script>
// Filter functions
document.getElementById('statusFilter')?.addEventListener('change', filterOrders);
document.getElementById('searchOrder')?.addEventListener('input', filterOrders);
document.getElementById('customerFilter')?.addEventListener('input', filterOrders);
document.getElementById('resetFilter')?.addEventListener('click', resetFilters);

function filterOrders() {
    const statusVal = document.getElementById('statusFilter')?.value || '';
    const searchVal = document.getElementById('searchOrder')?.value?.toLowerCase() || '';
    const customerVal = document.getElementById('customerFilter')?.value?.toLowerCase() || '';

    document.querySelectorAll('.order-item').forEach(item => {
        const status = item.dataset.status;
        const orderText = item.textContent.toLowerCase();
        
        const statusMatch = statusVal === '' || status === statusVal;
        const searchMatch = searchVal === '' || item.dataset.orderId?.includes(searchVal);
        const customerMatch = customerVal === '' || orderText.includes(customerVal);

        item.style.display = statusMatch && searchMatch && customerMatch ? '' : 'none';
    });
}

function resetFilters() {
    document.getElementById('statusFilter').value = '';
    document.getElementById('searchOrder').value = '';
    document.getElementById('customerFilter').value = '';
    
    document.querySelectorAll('.order-item').forEach(item => {
        item.style.display = '';
    });
}

// Confirm order button
document.querySelectorAll('.confirmOrderBtn').forEach(btn => {
    btn.onclick = async function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const orderId = this.dataset.orderId;
        const orderItem = document.querySelector(`[data-order-id="${orderId}"]`);
        const orderStatus = parseInt(orderItem.dataset.orderStatus);
        
        // Check current status
        if (orderStatus !== 0) {
            toastr.error("Đơn hàng không ở trạng thái chờ xác nhận");
            return;
        }
        
        if (!confirm("Xác nhận đơn hàng #" + orderId + "?")) return;

        try {
            const response = await fetch(`/AdminJewel/UpdateOrderStatus/${orderId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ Status: 1 })
            });
            const data = await response.json();

            if (data.success) {
                toastr.success(data.message);
                setTimeout(() => location.reload(), 1500);
            } else {
                toastr.error(data.message);
            }
        } catch (error) {
            toastr.error("Lỗi: " + error.message);
        }
    };
});

// Reject order button
document.querySelectorAll('.rejectOrderBtn').forEach(btn => {
    btn.onclick = async function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const orderId = this.dataset.orderId;
        const orderItem = document.querySelector(`[data-order-id="${orderId}"]`);
        const orderStatus = parseInt(orderItem.dataset.orderStatus);
        
        // Check current status
        if (orderStatus !== 0) {
            toastr.error("Đơn hàng không ở trạng thái chờ xác nhận");
            return;
        }
        
        if (!confirm("Từ chối đơn hàng #" + orderId + "?")) return;

        try {
            const response = await fetch(`/AdminJewel/UpdateOrderStatus/${orderId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ Status: 4 })
            });
            const data = await response.json();

            if (data.success) {
                toastr.success(data.message);
                setTimeout(() => location.reload(), 1500);
            } else {
                toastr.error(data.message);
            }
        } catch (error) {
            toastr.error("Lỗi: " + error.message);
        }
    };
});
</script>
