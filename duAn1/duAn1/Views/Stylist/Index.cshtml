@{
    ViewData["Title"] = "AI Stylist - Tư Vấn Sản Phẩm";
}

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 py-4">
    <div class="container mx-auto px-4 h-screen flex flex-col">
        <!-- Header -->
        <div class="text-center mb-4 pt-2">
            <div class="flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-purple-400">
                    <path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
                </svg>
                <h1 class="text-2xl font-bold text-white">AI Stylist</h1>
            </div>
        </div>

        <!-- Main Content - Chat + Products Split -->
        <div class="flex-1 grid grid-cols-10 gap-3 min-h-0">
            <!-- LEFT: Chat (3/10) -->
            <div class="col-span-3 bg-slate-800 rounded-lg shadow-2xl overflow-hidden border border-purple-500/20 flex flex-col">
                <!-- Chat Messages Area -->
                <div id="chatMessages" class="flex-1 overflow-y-auto p-3 space-y-3 bg-slate-800/50">
                    <!-- Welcome Message -->
                    <div class="flex gap-2 animate-fade-in">
                        <div class="w-7 h-7 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-4 h-4">
                                <path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="bg-slate-700 border border-purple-500/30 text-gray-100 rounded-lg px-3 py-2 max-w-xs">
                            <p class="font-semibold text-purple-300 text-sm">Xin chào!</p>
                            <p class="text-xs mt-1 leading-relaxed">Hỏi tôi về sản phẩm vòng tay bạc được hỗ trợ bởi AI</p>
                        </div>
                    </div>
                </div>

                <!-- Input Area -->
                <div class="border-t border-purple-500/20 p-2 bg-slate-700/50 backdrop-blur">
                    <form id="chatForm" class="flex gap-2" onsubmit="sendMessage(event)">
                        <input 
                            id="messageInput" 
                            type="text" 
                            placeholder="Hỏi tôi..." 
                            class="flex-grow bg-slate-600 border border-purple-500/30 text-white placeholder-gray-400 rounded-lg px-3 py-1.5 text-sm outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
                            autocomplete="off"
                        />
                        <button 
                            type="submit" 
                            id="sendBtn"
                            class="bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white px-3 py-1.5 rounded-lg font-semibold transition-all flex items-center gap-1 disabled:opacity-50 text-sm"
                            title="Gửi tin nhắn"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.125A59.769 59.769 0 0121.94 12c0 .205 0 .41-.001.614m0 0a60.016 60.016 0 01-21.939 12.875m19.5-12.75c0 .205 0 .41-.001.614" />
                            </svg>
                        </button>
                        <button 
                            type="button" 
                            id="clearBtn"
                            onclick="clearChat()"
                            class="bg-slate-600 hover:bg-slate-500 text-gray-300 hover:text-white px-2 py-1.5 rounded-lg transition-colors text-sm"
                            title="Xóa lịch sử"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L19.13 2.5a2.25 2.25 0 00-2.228-2.228H7.1a2.25 2.25 0 00-2.228 2.228l-.264 8.277m15.117-8.933a60.114 60.114 0 01-9.89 1.923M5.366 3.348a60.116 60.116 0 00-9.89 1.923m19.5 1.5-9.933 23.85m-9.867-23.85L5.366 5.348m0 0a2.25 2.25 0 00-2.228 2.228v8.277m0 0a2.25 2.25 0 002.228 2.228h15.8a2.25 2.25 0 002.228-2.228v-8.277" />
                            </svg>
                        </button>
                    </form>
                </div>
            </div>

            <!-- RIGHT: Products (7/10) -->
            <div class="col-span-7 bg-slate-800 rounded-lg shadow-2xl overflow-hidden border border-purple-500/20 flex flex-col">
                <!-- Products Title -->
                <div class="border-b border-purple-500/20 px-4 py-2 bg-slate-700/50 backdrop-blur">
                    <h3 class="text-sm font-bold text-white" id="productsTitle">Sản Phẩm Gợi Ý</h3>
                </div>

                <!-- Products Grid -->
                <div id="productsList" class="flex-1 overflow-y-auto p-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                    <!-- Products will be inserted here -->
                </div>

                <!-- Empty State -->
                <div id="emptyState" class="flex-1 flex items-center justify-center text-gray-400">
                    <p class="text-center text-sm">Hãy gửi tin nhắn để xem sản phẩm gợi ý</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .animate-fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }
    
    #chatMessages::-webkit-scrollbar {
        width: 4px;
    }
    
    #chatMessages::-webkit-scrollbar-track {
        background: rgba(30, 41, 59, 0.5);
    }
    
    #chatMessages::-webkit-scrollbar-thumb {
        background: rgba(168, 85, 247, 0.5);
        border-radius: 2px;
    }
    
    #chatMessages::-webkit-scrollbar-thumb:hover {
        background: rgba(168, 85, 247, 0.8);
    }

    #productsList::-webkit-scrollbar {
        width: 4px;
    }
    
    #productsList::-webkit-scrollbar-track {
        background: rgba(30, 41, 59, 0.5);
    }
    
    #productsList::-webkit-scrollbar-thumb {
        background: rgba(168, 85, 247, 0.5);
        border-radius: 2px;
    }
    
    #productsList::-webkit-scrollbar-thumb:hover {
        background: rgba(168, 85, 247, 0.8);
    }
</style>

<script>
    // Conversation state
    let sessionId = null;
    let conversation = [];
    let isLoading = false;
    let hasProducts = false;

    // Initialize session on page load
    window.addEventListener('load', () => {
        sessionId = localStorage.getItem('stylistSessionId') || generateSessionId();
        localStorage.setItem('stylistSessionId', sessionId);
        document.getElementById('messageInput').focus();
    });

    function generateSessionId() {
        return 'session_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
    }

    async function sendMessage(event) {
        event.preventDefault();

        const input = document.getElementById('messageInput');
        const message = input.value.trim();

        if (!message || isLoading) return;

        isLoading = true;
        document.getElementById('sendBtn').disabled = true;

        const chatMessages = document.getElementById('chatMessages');

        // Show user message
        const userMessage = document.createElement('div');
        userMessage.className = 'flex justify-end animate-fade-in';
        userMessage.innerHTML = `
            <div class="bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-lg px-3 py-1.5 max-w-xs text-sm">
                <p>${escapeHtml(message)}</p>
            </div>
        `;
        chatMessages.appendChild(userMessage);

        // Add to conversation history
        conversation.push({ role: 'user', content: message });

        // Show loading indicator
        const loadingDiv = document.createElement('div');
        loadingDiv.className = 'flex gap-2 animate-fade-in';
        loadingDiv.innerHTML = `
            <div class="w-7 h-7 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-4 h-4">
                    <path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="bg-slate-700 border border-purple-500/30 rounded-lg px-3 py-1.5">
                <div class="flex gap-1">
                    <div class="w-1.5 h-1.5 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 0s"></div>
                    <div class="w-1.5 h-1.5 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                    <div class="w-1.5 h-1.5 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 0.4s"></div>
                </div>
            </div>
        `;
        chatMessages.appendChild(loadingDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;

        // Clear input
        input.value = '';

        try {
            const response = await fetch('/api/stylist/chat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ 
                    userMessage: message,
                    sessionId: sessionId
                })
            });

            const data = await response.json();

            // Remove loading indicator
            loadingDiv.remove();

            if (data.success) {
                // Update session ID if changed
                if (data.sessionId) {
                    sessionId = data.sessionId;
                    localStorage.setItem('stylistSessionId', sessionId);
                }

                // Show AI response
                const aiMessage = document.createElement('div');
                aiMessage.className = 'flex gap-2 animate-fade-in';
                aiMessage.innerHTML = `
                    <div class="w-7 h-7 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-4 h-4">
                            <path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="bg-slate-700 border border-purple-500/30 text-gray-100 rounded-lg px-3 py-1.5 max-w-xs">
                        <p class="text-xs leading-relaxed">${escapeHtml(data.message)}</p>
                    </div>
                `;
                chatMessages.appendChild(aiMessage);

                // Add to conversation history
                conversation.push({ role: 'assistant', content: data.message });

                // Display products if recommended
                if (data.products && data.products.length > 0) {
                    displayProducts(data.products);
                }

                chatMessages.scrollTop = chatMessages.scrollHeight;
            } else {
                toastr.error(data.message || 'Lỗi không xác định');
            }
        } catch (error) {
            loadingDiv.remove();
            toastr.error("Lỗi: " + error.message);
            console.error(error);
        } finally {
            isLoading = false;
            document.getElementById('sendBtn').disabled = false;
            input.focus();
        }
    }

    function displayProducts(products) {
        const list = document.getElementById('productsList');
        const emptyState = document.getElementById('emptyState');
        const title = document.getElementById('productsTitle');
        const img404 = "https://png.pngtree.com/thumb_back/fw800/background/20220119/pngtree-404-error-and-page-not-found-image_983763.jpg;
        list.innerHTML = '';
        hasProducts = true;
        emptyState.style.display = 'none';
        title.textContent = `Gợi Ý (${products.length})`;

        products.forEach(product => {
            const card = document.createElement('div');
            card.className = 'bg-slate-700 border border-purple-500/30 rounded-lg overflow-hidden hover:border-purple-500 transition-all cursor-pointer hover:shadow-lg hover:shadow-purple-500/20 group';
            card.innerHTML = `
                <div class="relative aspect-square overflow-hidden bg-slate-600">
                    <img src="${escapeHtml(product.image)}" alt="${escapeHtml(product.name)}" class="w-full h-full object-cover group-hover:scale-110 transition-transform" onerror="this.src='${img404}'" />
                    <div class="absolute top-2 right-2 bg-gradient-to-r from-purple-600 to-pink-600 rounded px-2 py-1 text-xs font-bold text-white">
                        ${product.price.toLocaleString('vi-VN')}đ
                    </div>
                </div>
                
                <div class="p-2">
                    <h3 class="font-semibold text-gray-100 text-xs line-clamp-2">${escapeHtml(product.name)}</h3>
                    <p class="text-xs text-gray-400 mt-0.5">${escapeHtml(product.category_name)}</p>
                    
                    <div class="flex items-center gap-1 mt-1 text-xs text-gray-400">
                        <span>📊${product.total_sales}</span>
                        <span>❤️${product.total_favorites}</span>
                    </div>
                    
                    <div class="flex gap-1 mt-2">
                        <a href="/CollectionProduct/ProductDetail/${product.id}" class="flex-1 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white text-center py-1 rounded text-xs font-semibold transition-all">
                            Chi Tiết
                        </a>
                        <button onclick="addToCart(${product.id}, 1)" class="flex-1 bg-slate-600 hover:bg-slate-500 text-gray-300 py-1 rounded text-xs font-semibold transition-colors">
                            +Giỏ
                        </button>
                    </div>
                </div>
            `;
            list.appendChild(card);
        });
    }

    async function addToCart(productId, quantity) {
        try {
            const response = await fetch(`/Cart/AddToCart?productId=${productId}&quantity=${quantity}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();
            if (data.success) {
                toastr.success('Đã thêm vào giỏ hàng');
                if (window.updateCartCount) {
                    window.updateCartCount();
                }
            } else {
                toastr.error(data.message);
            }
        } catch (error) {
            toastr.error("Lỗi: " + error.message);
        }
    }

    async function clearChat() {
        if (!confirm('Bạn có chắc muốn xóa lịch sử chat?')) return;

        try {
            await fetch('/api/stylist/clear', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ sessionId })
            });

            // Clear UI
            const chatMessages = document.getElementById('chatMessages');
            chatMessages.innerHTML = `
                <div class="flex gap-2 animate-fade-in">
                    <div class="w-7 h-7 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-4 h-4">
                            <path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="bg-slate-700 border border-purple-500/30 text-gray-100 rounded-lg px-3 py-2 max-w-xs">
                        <p class="font-semibold text-purple-300 text-sm">Lịch sử đã xóa</p>
                    </div>
                </div>
            `;
            document.getElementById('productsList').innerHTML = '';
            document.getElementById('emptyState').style.display = 'flex';
            document.getElementById('productsTitle').textContent = 'Sản Phẩm Gợi Ý';
            conversation = [];
            hasProducts = false;
            toastr.info('Lịch sử chat đã xóa');
        } catch (error) {
            toastr.error("Lỗi: " + error.message);
        }
    }

    function escapeHtml(text) {
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, m => map[m]);
    }
</script>

