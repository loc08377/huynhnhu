<!-- AI Stylist Floating Widget -->

<!-- Floating Chat Button -->
<button id="floatingBtn" class="fixed bottom-6 right-6 z-40 w-14 h-14 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white rounded-full shadow-2xl flex items-center justify-center transition-all duration-300 hover:scale-110" title="AI Stylist">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7">
        <path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
    </svg>
</button>

<!-- Chat Modal -->
<div id="chatModal" class="fixed inset-0 bg-black/50 z-40 hidden transition-opacity duration-300 flex items-center justify-center p-4">
    <!-- Modal Content -->
    <div id="modalContent" class="w-full max-w-md h-[600px] bg-slate-800 rounded-lg shadow-2xl border border-purple-500/20 flex flex-col overflow-hidden transition-all duration-300 fixed bottom-6 right-6 max-h-[calc(100vh-50px)]">
        
        <!-- Modal Header -->
        <div class="bg-gradient-to-r from-purple-600 to-pink-600 px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-white">
                    <path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
                </svg>
                <h2 class="text-white font-bold">AI Stylist</h2>
            </div>
            <button type="button" id="closeBtn" class="text-white hover:bg-white/20 p-1 rounded transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Chat Messages Area -->
        <div id="chatMessages" class="flex-1 overflow-y-auto p-3 space-y-3 bg-slate-800/50">
            <!-- Welcome Message -->
            <div class="flex gap-2 animate-fade-in">
                <div class="w-7 h-7 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-4 h-4">
                        <path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="bg-slate-700 border border-purple-500/30 text-gray-100 rounded-lg px-3 py-2 max-w-xs">
                    <p class="font-semibold text-purple-300 text-sm">Xin chào!</p>
                    <p class="text-xs mt-1 leading-relaxed">Hỏi tôi về sản phẩm vòng tay bạc</p>
                </div>
            </div>
        </div>

        <!-- Input Area -->
        <div class="border-t border-purple-500/20 p-2 bg-slate-700/50 backdrop-blur">
            <form id="chatForm" class="flex gap-2" onsubmit="sendMessage(event)">
                <input 
                    id="messageInput" 
                    type="text" 
                    placeholder="Hỏi tôi..." 
                    class="flex-grow bg-slate-600 border border-purple-500/30 text-white placeholder-gray-400 rounded-lg px-3 py-1.5 text-sm outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500"
                    autocomplete="off"
                />
                <button 
                    type="submit"
                    id="sendBtn"
                    class="bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white px-3 py-1.5 rounded-lg font-semibold transition-all flex items-center gap-1 disabled:opacity-50 text-sm"
                    title="Gửi"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.125A59.769 59.769 0 0121.94 12c0 .205 0 .41-.001.614m0 0a60.016 60.016 0 01-21.939 12.875m19.5-12.75c0 .205 0 .41-.001.614" />
                    </svg>
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    @@keyframes slideUp {
        from {
            transform: translateY(20px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
    
    .animate-fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }

    /* Modal animation */
    #chatModal:not(.hidden) {
        animation: fadeIn 0.2s ease-in-out;
    }

    #chatModal:not(.hidden) #modalContent {
        animation: slideUp 0.3s ease-out;
    }
    
    #chatMessages::-webkit-scrollbar {
        width: 4px;
    }
    
    #chatMessages::-webkit-scrollbar-track {
        background: rgba(30, 41, 59, 0.5);
    }
    
    #chatMessages::-webkit-scrollbar-thumb {
        background: rgba(168, 85, 247, 0.5);
        border-radius: 2px;
    }
    
    #chatMessages::-webkit-scrollbar-thumb:hover {
        background: rgba(168, 85, 247, 0.8);
    }
</style>

<script src="~/js/price-formatter.js"></script>
<script>
    // Conversation state
    let sessionId = null;
    let conversation = [];
    let isLoading = false;

    // Initialize session on page load
    window.addEventListener('load', () => {
        sessionId = localStorage.getItem('stylistSessionId') || generateSessionId();
        localStorage.setItem('stylistSessionId', sessionId);
    });

    function generateSessionId() {
        return 'session_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
    }

    async function sendMessage(event) {
        event.preventDefault();

        const input = document.getElementById('messageInput');
        const message = input.value.trim();

        if (!message || isLoading) return;

        isLoading = true;
        const sendBtn = document.getElementById('sendBtn');
        sendBtn.disabled = true;

        const chatMessages = document.getElementById('chatMessages');

        // Show user message
        const userMessage = document.createElement('div');
        userMessage.className = 'flex justify-end animate-fade-in';
        userMessage.innerHTML = `
            <div class="bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-lg px-3 py-1.5 max-w-xs text-sm">
                <p>${escapeHtml(message)}</p>
            </div>
        `;
        chatMessages.appendChild(userMessage);

        // Add to conversation history
        conversation.push({ role: 'user', content: message });

        // Show loading indicator
        const loadingDiv = document.createElement('div');
        loadingDiv.className = 'flex gap-2 animate-fade-in';
        loadingDiv.innerHTML = `
            <div class="w-7 h-7 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-4 h-4">
                    <path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="bg-slate-700 border border-purple-500/30 rounded-lg px-3 py-1.5">
                <div class="flex gap-1">
                    <div class="w-1.5 h-1.5 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 0s"></div>
                    <div class="w-1.5 h-1.5 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                    <div class="w-1.5 h-1.5 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 0.4s"></div>
                </div>
            </div>
        `;
        chatMessages.appendChild(loadingDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;

        // Clear input
        input.value = '';

        try {
            const response = await fetch('/api/stylist/chat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ 
                    userMessage: message,
                    sessionId: sessionId
                })
            });

            const data = await response.json();

            // Remove loading indicator
            loadingDiv.remove();

            if (data.success) {
                // Update session ID if changed
                if (data.sessionId) {
                    sessionId = data.sessionId;
                    localStorage.setItem('stylistSessionId', sessionId);
                }

                // Show AI response
                const aiMessage = document.createElement('div');
                aiMessage.className = 'flex gap-2 animate-fade-in';
                aiMessage.innerHTML = `
                    <div class="w-7 h-7 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-4 h-4">
                            <path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="bg-slate-700 border border-purple-500/30 text-gray-100 rounded-lg px-3 py-1.5 max-w-xs">
                        <p class="text-xs leading-relaxed">${escapeHtml(data.message)}</p>
                    </div>
                `;
                chatMessages.appendChild(aiMessage);

                // Add to conversation history
                conversation.push({ role: 'assistant', content: data.message });

                chatMessages.scrollTop = chatMessages.scrollHeight;
            } else {
                console.error('API Error:', data.message);
                const errorMsg = document.createElement('div');
                errorMsg.className = 'flex gap-2 animate-fade-in';
                errorMsg.innerHTML = `
                    <div class="w-7 h-7 bg-red-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="white" viewBox="0 0 24 24" class="w-4 h-4">
                            <path d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </div>
                    <div class="bg-red-900/50 border border-red-500/30 text-red-100 rounded-lg px-3 py-1.5 max-w-xs">
                        <p class="text-xs">${escapeHtml(data.message || 'Lỗi không xác định')}</p>
                    </div>
                `;
                chatMessages.appendChild(errorMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        } catch (error) {
            loadingDiv.remove();
            console.error('Fetch Error:', error);
            const errorMsg = document.createElement('div');
            errorMsg.className = 'flex gap-2 animate-fade-in';
            errorMsg.innerHTML = `
                <div class="w-7 h-7 bg-red-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="white" viewBox="0 0 24 24" class="w-4 h-4">
                        <path d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </div>
                <div class="bg-red-900/50 border border-red-500/30 text-red-100 rounded-lg px-3 py-1.5 max-w-xs">
                    <p class="text-xs">Lỗi: ${escapeHtml(error.message)}</p>
                </div>
            `;
            chatMessages.appendChild(errorMsg);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        } finally {
            isLoading = false;
            sendBtn.disabled = false;
            input.focus();
        }
    }

    function escapeHtml(text) {
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    // Floating Button & Modal Controls
    const floatingBtn = document.getElementById('floatingBtn');
    const chatModal = document.getElementById('chatModal');
    const modalContent = document.getElementById('modalContent');
    const closeBtn = document.getElementById('closeBtn');

    if (floatingBtn && chatModal) {
        // Open/Close Modal
        floatingBtn.addEventListener('click', () => {
            chatModal.classList.toggle('hidden');
            if (!chatModal.classList.contains('hidden')) {
                setTimeout(() => document.getElementById('messageInput').focus(), 100);
            }
        });

        // Close button click
        closeBtn.addEventListener('click', () => {
            chatModal.classList.add('hidden');
        });

        // Close modal when clicking outside
        chatModal.addEventListener('click', (e) => {
            if (e.target === chatModal) {
                chatModal.classList.add('hidden');
            }
        });

        // Prevent closing when clicking inside modal content
        modalContent.addEventListener('click', (e) => {
            e.stopPropagation();
        });
    }
</script>
