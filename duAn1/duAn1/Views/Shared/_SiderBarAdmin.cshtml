<script>
    document.addEventListener('DOMContentLoaded', () => {
        const currentPath = window.location.pathname.toLowerCase();
        const navLinks = document.querySelectorAll('aside a[asp-controller]');
        
        navLinks.forEach(link => {
            const href = link.getAttribute('href') || '';
            if (href && currentPath.includes(href.toLowerCase())) {
                link.classList.add('bg-blue-100', 'text-blue-600', 'font-semibold');
                link.classList.remove('text-slate-600');
            }
        });

        // Order menu toggle
        const orderMenuBtn = document.getElementById('orderMenuBtn');
        const orderSubmenu = document.getElementById('orderSubmenu');
        const orderArrow = document.getElementById('orderArrow');

        orderMenuBtn.addEventListener('click', function(e) {
            e.preventDefault();
            orderSubmenu.classList.toggle('hidden');
            orderArrow.classList.toggle('rotate-180');
        });

        // Status filter links
        document.querySelectorAll('.order-status-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const status = this.dataset.status;
                
                // Navigate to OrderManager with status filter
                if (status === '') {
                    window.location.href = '/AdminJewel/OrderManager';
                } else {
                    window.location.href = `/AdminJewel/OrderManager?status=${status}`;
                }
            });
        });

        // Auto-expand menu if on OrderManager page
        if (currentPath.includes('ordermanager')) {
            orderSubmenu.classList.remove('hidden');
            orderArrow.classList.add('rotate-180');

            // Highlight active status
            const params = new URLSearchParams(window.location.search);
            const activeStatus = params.get('status') || '';
            
            document.querySelectorAll('.order-status-link').forEach(link => {
                const status = link.dataset.status;
                if (status === activeStatus) {
                    link.classList.add('bg-slate-100', 'text-blue-600', 'font-semibold');
                    link.classList.remove('text-slate-600');
                }
            });
        }
    });
</script>