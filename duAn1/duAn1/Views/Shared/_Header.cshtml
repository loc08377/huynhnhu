<header>
	<nav class="sticky top-0 z-50 glass-panel border-b border-white/40 shadow-sm">
		<div class="container mx-auto px-4 h-20 flex items-center justify-between">

			<!-- Logo -->
			<a href="/Home/Index" class="flex items-center gap-2 text-2xl font-bold text-blue-900" style="font-family: 'Cormorant Garamond', serif;">
				<div class="w-8 h-8 bg-gradient-to-tr from-blue-400 to-blue-600 rounded-full flex items-center justify-center text-white text-base font-bold">
					J
				</div>
				JewelAI
			</a>

			<!-- Desktop Menu -->
			<div class="hidden md:flex items-center gap-8">
				<a href="/Home/Index" class="text-blue-600 font-bold transition-colors hover:text-blue-700">Trang Chủ</a>
				<a asp-controller="Home" asp-action="Collection" class="text-slate-600 hover:text-blue-600 transition-colors">Sản Phẩm</a>
				<a href="/stylist" class="text-slate-600 hover:text-blue-600 transition-colors flex items-center gap-1">
					<!-- Sparkle icon -->
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-purple-500">
						<path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
					</svg>
					AI Stylist
				</a>
			</div>

			<!-- Icons + Login -->
			<div class="flex items-center gap-4">

				<!-- Wishlist -->
				<a href="/Home/Favorites" class="relative text-slate-600 hover:text-pink-500 transition-colors p-2" title="Yêu thích">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
					</svg>
					<!-- Badge (ẩn khi không có item) -->
					<span id="favorite-count"
						class="absolute -top-1 -right-1 bg-pink-500 text-white text-[10px] w-5 h-5 flex items-center justify-center rounded-full hidden">
						0
					</span>
				</a>

				<!-- Cart -->
				<a href="/cart" 
				class="relative text-slate-600 hover:text-blue-600 transition-colors p-2" 
				title="Giỏ hàng">

					<svg xmlns="http://www.w3.org/2000/svg" 
						fill="none" 
						viewBox="0 0 24 24" 
						stroke-width="1.5" 
						stroke="currentColor" 
						class="w-6 h-6">
						
						<path stroke-linecap="round" 
							stroke-linejoin="round" 
							d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
					</svg>

					<!-- Cart Badge -->
					<span id="cart-count"
						class="absolute -top-1 -right-1 bg-red-600 text-white text-[10px] w-5 h-5 flex items-center justify-center rounded-full hidden">
						0
					</span>

				</a>
				<a href="/Order/Index" 
					class="relative text-slate-600 hover:text-blue-600 transition-colors p-2" 
					title="Đơn hàng">

					<svg xmlns="http://www.w3.org/2000/svg" 
						fill="none" 
						viewBox="0 0 24 24" 
						stroke-width="1.5" 
						stroke="currentColor" 
						class="w-6 h-6">

					<path stroke-linecap="round" 
							stroke-linejoin="round" 
							d="M3 7.5h11.25v7.5H3v-7.5zM14.25 10.5h3.188a1.5 1.5 0 011.299.75l1.513 2.625v1.125h-6V10.5z"/>

					<circle cx="7.5" cy="18" r="1.5"/>
					<circle cx="18" cy="18" r="1.5"/>

					</svg>

					<!-- Cart Badge -->
					<span id="cart-count"
						class="absolute -top-1 -right-1 bg-red-600 text-white text-[10px] w-5 h-5 flex items-center justify-center rounded-full hidden">
						0
					</span>

				</a>


				@if (User?.Identity == null || !User.Identity.IsAuthenticated)
				{
					<!-- Login Button -->
					<a asp-controller="Home" asp-action="Login" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold py-2 px-4 rounded-full transition-colors shadow-md">
						Đăng Nhập
					</a>
				}
				else
				{
					<div class="relative">
						<button class="flex items-center gap-2 px-4 py-2 bg-slate-100 rounded-full hover:bg-blue-100 transition-colors focus:outline-none" id="userMenuBtn" type="button">
							<img src="/images/avatar-default.png" alt="avatar" class="w-8 h-8 rounded-full border border-blue-300" />
							<span class="font-semibold text-blue-900">@User.Identity.Name</span>
							<svg class="w-4 h-4 text-slate-500 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
						</button>
						<div id="userMenu" class="absolute right-0 mt-2 w-40 bg-white border border-gray-200 rounded-lg shadow-lg hidden z-50">
							<form asp-controller="Home" asp-action="Logout" method="post" class="block">
								<button type="submit" class="w-full text-left px-4 py-2 hover:bg-blue-50 text-slate-700">Đăng xuất</button>
							</form>
						</div>
					</div>
					<script>
						document.addEventListener('DOMContentLoaded', function() {
							var btn = document.getElementById('userMenuBtn');
							var menu = document.getElementById('userMenu');
							if (btn && menu) {
								btn.addEventListener('mouseenter', function() {
									menu.classList.remove('hidden');
								});
								btn.addEventListener('mouseleave', function() {
									setTimeout(function() { menu.classList.add('hidden'); }, 200);
								});
								menu.addEventListener('mouseenter', function() {
									menu.classList.remove('hidden');
								});
								menu.addEventListener('mouseleave', function() {
									menu.classList.add('hidden');
								});
							}
						});
					</script>
				}

			</div>
		</div>
	</nav>
</header>