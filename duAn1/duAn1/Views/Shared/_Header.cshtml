<header>
	<nav class="sticky top-0 z-50 glass-panel border-b border-white/40 shadow-sm">
		<div class="container mx-auto px-4 h-20 flex items-center justify-between">

			<!-- Logo -->
			<a href="/Home/Index" class="flex items-center gap-2 text-2xl font-bold text-blue-900" style="font-family: 'Cormorant Garamond', serif;">
				<div class="w-8 h-8 bg-gradient-to-tr from-blue-400 to-blue-600 rounded-full flex items-center justify-center text-white text-base font-bold">
					J
				</div>
				JewelAI
			</a>

			<!-- Desktop Menu -->
			<div class="hidden md:flex items-center gap-8">
				<a href="/Home/Index" class="text-blue-600 font-bold transition-colors hover:text-blue-700">Trang Chủ</a>
				<a asp-controller="Home" asp-action="Collection" class="text-slate-600 hover:text-blue-600 transition-colors">Sản Phẩm</a>
				<a href="/stylist" class="text-slate-600 hover:text-blue-600 transition-colors flex items-center gap-1">
					<!-- Sparkle icon -->
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-purple-500">
						<path fill-rule="evenodd" d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813a3.75 3.75 0 002.576-2.576l.813-2.846A.75.75 0 019 4.5z" clip-rule="evenodd" />
					</svg>
					AI Stylist
				</a>
			</div>

			<!-- Icons + Login -->
			<div class="flex items-center gap-4">

				<!-- Wishlist -->
				<a href="/Home/Favorites" class="relative text-slate-600 hover:text-pink-500 transition-colors p-2" title="Yêu thích">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
					</svg>
					<!-- Badge (ẩn khi không có item) -->
					<span id="favorite-count"
						class="absolute -top-1 -right-1 bg-pink-500 text-white text-[10px] w-5 h-5 flex items-center justify-center rounded-full hidden">
						0
					</span>
				</a>

				<!-- Cart -->
				<a href="/cart" 
				class="relative text-slate-600 hover:text-blue-600 transition-colors p-2" 
				title="Giỏ hàng">

					<svg xmlns="http://www.w3.org/2000/svg" 
						fill="none" 
						viewBox="0 0 24 24" 
						stroke-width="1.5" 
						stroke="currentColor" 
						class="w-6 h-6">
						
						<path stroke-linecap="round" 
							stroke-linejoin="round" 
							d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
					</svg>

					<!-- Cart Badge -->
					<span id="cart-count"
						class="absolute -top-1 -right-1 bg-red-600 text-white text-[10px] w-5 h-5 flex items-center justify-center rounded-full hidden">
						0
					</span>

				</a>
				<a href="/Order/Index" 
					class="relative text-slate-600 hover:text-blue-600 transition-colors p-2" 
					title="Đơn hàng">

					<svg xmlns="http://www.w3.org/2000/svg" 
						fill="none" 
						viewBox="0 0 24 24" 
						stroke-width="1.5" 
						stroke="currentColor" 
						class="w-6 h-6">

					<path stroke-linecap="round" 
							stroke-linejoin="round" 
							d="M3 7.5h11.25v7.5H3v-7.5zM14.25 10.5h3.188a1.5 1.5 0 011.299.75l1.513 2.625v1.125h-6V10.5z"/>

					<circle cx="7.5" cy="18" r="1.5"/>
					<circle cx="18" cy="18" r="1.5"/>

					</svg>

					<!-- Cart Badge -->
					<span id="cart-count"
						class="absolute -top-1 -right-1 bg-red-600 text-white text-[10px] w-5 h-5 flex items-center justify-center rounded-full hidden">
						0
					</span>

				</a>


<!-- Auth Section -->
			<div class="flex items-center">
				@if (User?.Identity == null || !User.Identity.IsAuthenticated)
				{
					<!-- Login Button -->
					<a asp-controller="Home" asp-action="Login" class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white text-sm font-semibold py-2 px-6 rounded-full transition-all duration-200 shadow-md hover:shadow-lg hover:scale-105 active:scale-95">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 1114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
						</svg>
						Đăng Nhập
					</a>
				}
				else
				{
					<!-- User Menu Dropdown -->
					<div class="relative" id="userMenuContainer">
						<!-- Menu Button -->
						<button class="flex items-center gap-2 px-3 py-2 bg-gradient-to-r from-slate-50 to-blue-50 rounded-full hover:from-blue-50 hover:to-blue-100 transition-all duration-200 focus:outline-none" id="userMenuBtn" type="button">
							<img src="/images/avatar-default.png" alt="avatar" class="w-8 h-8 rounded-full border-2 border-blue-300 hover:border-blue-500 transition-colors" />
							<span class="font-semibold text-blue-900 hidden sm:inline max-w-[100px] truncate">@User.Identity.Name</span>
							<svg class="w-4 h-4 text-slate-600 hover:text-blue-600 transition-all duration-200" id="menuIcon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
							</svg>
						</button>

						<!-- Dropdown Menu -->
						<div id="userMenu" class="absolute right-0 mt-2 w-48 bg-white border border-gray-200 rounded-lg shadow-xl hidden z-50 " style="top: 40px;"	>
							<!-- Menu Items -->
							<div class="py-2">
								<!-- Change Password Button -->
								<button id="changePasswordBtn" class="w-full flex items-center gap-2 px-4 py-2 hover:bg-blue-50 text-slate-700 hover:text-blue-700 transition-colors text-sm" type="button">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
									</svg>
									<span>Đổi mật khẩu</span>
								</button>
							</div>

							<!-- Logout Section -->
							<div class="border-t border-gray-100">
								<form asp-controller="Home" asp-action="Logout" method="post" class="block">
									<button type="submit" class="w-full flex items-center gap-2 px-4 py-2 hover:bg-red-50 text-red-600 hover:text-red-700 font-medium transition-colors text-sm py-3">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
											<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3-3l3-3m0 0l-3-3m3 3H9" />
										</svg>
										<span>Đăng xuất</span>
									</button>
								</form>
							</div>
						</div>
					</div>

					<!-- User Menu JavaScript -->
					<script>
						document.addEventListener('DOMContentLoaded', function() {
							const container = document.getElementById('userMenuContainer');
							const btn = document.getElementById('userMenuBtn');
							const menu = document.getElementById('userMenu');
							const icon = document.getElementById('menuIcon');
							const changePasswordBtn = document.getElementById('changePasswordBtn');

							if (btn && menu && container) {
								// Show menu on hover
								container.addEventListener('mouseenter', function() {
									menu.classList.remove('hidden');
									icon.style.transform = 'rotate(180deg)';
								});

								// Hide menu when leaving container
								container.addEventListener('mouseleave', function() {
									menu.classList.add('hidden');
									icon.style.transform = 'rotate(0deg)';
								});

								// Change password button click
								if (changePasswordBtn) {
									changePasswordBtn.addEventListener('click', function(e) {
										e.preventDefault();
										showChangePasswordModal();
										menu.classList.add('hidden');
										icon.style.transform = 'rotate(0deg)';
									});
								}
							}
						});

						function showChangePasswordModal() {
							const modal = document.getElementById('changePasswordModal');
							if (modal) {
								modal.classList.remove('hidden');
								modal.classList.add('flex');
								document.getElementById('oldPasswordInput').focus();
							}
						}

						function hideChangePasswordModal() {
							const modal = document.getElementById('changePasswordModal');
							if (modal) {
								modal.classList.add('hidden');
								modal.classList.remove('flex');
								document.getElementById('changePasswordForm').reset();
							}
						}

						function submitChangePassword() {
							const oldPassword = document.getElementById('oldPasswordInput').value;
							const newPassword = document.getElementById('newPasswordInput').value;
							const confirmPassword = document.getElementById('confirmPasswordInput').value;

							if (!oldPassword || !newPassword || !confirmPassword) {
								alert('Vui lòng điền đầy đủ thông tin');
								return;
							}

							if (newPassword !== confirmPassword) {
								alert('Mật khẩu mới không khớp');
								return;
							}

							if (newPassword.length < 6) {
								alert('Mật khẩu mới phải có ít nhất 6 kí tự');
								return;
							}

							fetch('/api/change-password', {
								method: 'POST',
								headers: {
									'Content-Type': 'application/json'
								},
								body: JSON.stringify({
									oldPassword: oldPassword,
									newPassword: newPassword
								})
							})
							.then(response => response.json())
							.then(data => {
								if (data.success) {
									alert('Đổi mật khẩu thành công! Vui lòng đăng nhập lại');
									window.location.href = '/Home/Logout';
								} else {
									alert('Lỗi: ' + data.message);
								}
							})
							.catch(error => {
								console.error('Error:', error);
								alert('Có lỗi xảy ra. Vui lòng thử lại');
							});
						}
					</script>
				}
			</div>

			</div>
		</div>
	</nav>

	<!-- Change Password Modal -->
	<div id="changePasswordModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
		<div class="bg-white rounded-lg shadow-2xl w-96 p-6">
			<!-- Header -->
			<div class="flex items-center justify-between mb-4">
				<h2 class="text-xl font-bold text-gray-800">Đổi mật khẩu</h2>
				<button onclick="hideChangePasswordModal()" class="text-gray-400 hover:text-gray-600">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>

			<!-- Form -->
			<form id="changePasswordForm" onsubmit="submitChangePassword(); return false;" class="space-y-4">
				<!-- Old Password -->
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Mật khẩu cũ</label>
					<input type="password" id="oldPasswordInput" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Nhập mật khẩu cũ" required>
				</div>

				<!-- New Password -->
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Mật khẩu mới</label>
					<input type="password" id="newPasswordInput" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Nhập mật khẩu mới" required>
				</div>

				<!-- Confirm Password -->
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Xác nhận mật khẩu mới</label>
					<input type="password" id="confirmPasswordInput" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Xác nhận mật khẩu mới" required>
				</div>

				<!-- Buttons -->
				<div class="flex gap-3 pt-4">
					<button type="button" onclick="hideChangePasswordModal()" class="flex-1 px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition-colors font-medium">
						Hủy
					</button>
					<button type="submit" class="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium">
						Đặt lại
					</button>
				</div>
			</form>
		</div>
	</div>
</header>