@model List<Product>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-slate-800 mb-2 font-serif text-center">Sản Phẩm Yêu Thích</h1>
    <p class="text-center text-slate-600 mb-8">Danh sách các sản phẩm bạn đã lưu</p>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-16">
            <div class="max-w-md mx-auto">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 text-gray-300 mx-auto mb-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                </svg>
                <h3 class="text-xl font-bold text-slate-600 mb-2">Chưa có sản phẩm yêu thích</h3>
                <p class="text-slate-500 mb-6">Hãy thêm các sản phẩm yêu thích của bạn để xem ở đây</p>
                <a href="/Home/Collection" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-full transition-all">Khám Phá Sản Phẩm</a>
            </div>
        </div>
    }
    else
    {
        <!-- Grid -->
        <div id="product-container" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
            @foreach (var item in Model)
            {
                <div class="glass-card rounded-xl overflow-hidden group flex flex-col h-full animate-fade-in cursor-pointer border border-white/50">
                    <div class="relative h-48 md:h-56 overflow-hidden bg-white">
                        <a asp-controller="Product" asp-action="ProductDetail" asp-route-id="@item.Id" class="block absolute inset-0 z-10"></a>
                        <img src="@item.Image" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 relative z-0" alt="@item.Name" />
                        <button onclick="toggleFavorite(@item.Id, this)" class="favorite-btn absolute top-2 right-2 p-1.5 rounded-full bg-pink-500/20 hover:bg-pink-500 text-pink-500 hover:text-white transition-all shadow-sm z-20 backdrop-blur-sm group favorite-active" title="Xóa khỏi yêu thích">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                                <path d="M11.645 20.745A.75.75 0 1012.355 20.745L11.645 20.745zm0 0a.75.75 0 001.71 0c0-1.949-1.308-3.809-3.233-4.61-.913-.419-1.841-.643-2.715-.815.097-.102.194-.204.291-.303.638-.57.968-.868 1.293-1.154.325.286.655.584 1.293 1.154.097.099.194.201.291.303-.874.172-1.802.396-2.715.815C3.253 16.936 1.945 18.796 1.945 20.745z"/>
                                <path fill-rule="evenodd" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" clip-rule="evenodd" />
                            </svg>
                        </button>
                    </div>
                    <div class="p-3 flex flex-col flex-grow">
                        <div class="text-[10px] text-blue-500 font-semibold uppercase tracking-wider mb-1">@(item.Category?.Name ?? "Không xác định")</div>
                        <a asp-controller="Product" asp-action="ProductDetail" asp-route-id="@item.Id" class="block">
                            <h3 class="text-sm font-bold text-slate-800 mb-1 font-serif group-hover:text-blue-600 transition-colors line-clamp-2 min-h-[2.5em]">@item.Name</h3>
                        </a>
                        <div class="mt-auto pt-2 flex items-center justify-between">
                            <span class="text-base font-bold text-blue-600">@duAn1.Utils.PriceFormatter.FormatVND(item.Price)</span>
                            <button onclick="addCart(@item.Id)" class="bg-slate-800 hover:bg-blue-600 text-white w-8 h-8 rounded-lg transition-all shadow-md flex items-center justify-center active:scale-95 z-20" title="Thêm vào giỏ">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0v3m0-3h3m-3 0H9" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .animate-fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }

    .favorite-btn {
        transition: all 0.3s ease;
    }

    .favorite-btn.favorite-active {
        background-color: rgba(236, 72, 153, 0.2);
        color: rgb(236, 72, 153);
    }
</style>

<script>
    async function toggleFavorite(productId, btn) {
        try {
            const response = await fetch(`/Home/ToggleFavorite?productId=${productId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (data.status) {
                if (data.isFavorited) {
                    btn.classList.add('favorite-active');
                    btn.title = 'Xóa khỏi yêu thích';
                    toastr.success(data.message);
                } else {
                    btn.classList.remove('favorite-active');
                    btn.title = 'Thêm vào yêu thích';
                    toastr.info(data.message);
                    // Remove from page after 1 second
                    setTimeout(() => {
                        location.reload();
                    }, 500);
                }
            } else {
                if (data.redirect) {
                    window.location.href = data.redirect;
                } else {
                    toastr.error(data.message);
                }
            }
        } catch (error) {
            toastr.error('Lỗi: ' + error.message);
        }
    }

    async function addCart(productId) {
        try {
            const response = await fetch(`/Cart/AddToCart?productId=${productId}&quantity=1`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();
            if (data.status) {
                toastr.success(data.message);
                if (window.updateCartCount) {
                    window.updateCartCount();
                }
            } else {
                if (data.redirect) {
                    window.location.href = data.redirect;
                } else {
                    toastr.error(data.message);
                }
            }
        } catch (error) {
            toastr.error('Lỗi: ' + error.message);
        }
    }
</script>
